+/* aw87559_pa.h — Awinic AW87559 speaker amplifier, Q5 board glue (bob-m2-spec §3.4, D13).
+ *
+ * Chip contract (artificery-dev/tempo, porting/audio.md — the Y2 lineage documented
+ * the vendor's aw87559_on/aw87559_off register images; this driver is the legacy-3.10
+ * port of that contract, per D13 "self-contained I2C amp driver, legacy i2c API"):
+ *   - chip id reg 0x00: 0x5a = AW87559, 0x09 = OCA72559 (drop-in alternative)
+ *   - enable pulse: EN low 10 ms → high 100 ms; retry id read up to 5 times
+ *   - on: vendor register image, SYSCTRL (0x01) written last; then wait 80 ms
+ *   - off: SYSCTRL = 0x30 (mute) and drop the enable line
+ *
+ * Q5 board wiring (D14 / bob-m2 hardware-facts §2.5): amp at I2C bus 2, addr 0x58
+ * ("2-0058 aw87559_pa" live under Mint). The Q5 amp-enable GPIO is NOT evidenced in
+ * any live capture, so this port drives the chip over I2C only — no GPIO value is
+ * invented (hard rule, bob-m1 §2.0 / bob-m2 §4.4). If G4 shows the chip needs its
+ * EN line toggled, land the board GPIO from dmesg evidence as a follow-up delta.
+ */
+#ifndef _AW87559_PA_H_
+#define _AW87559_PA_H_
+
+#define AW87559_I2C_NAME	"aw87559_pa"
+#define AW87559_I2C_ADDR	(0x58)
+#define AW87559_I2C_BUS		(2)	/* D14: bus 2 — NOT bus 1 (hardware-facts §2.5) */
+
+#define AW87559_REG_CHIPID	0x00
+#define AW87559_REG_SYSCTRL	0x01
+
+#define AW87559_CHIPID		0x5a
+#define OCA72559_CHIPID		0x09
+
+/* the chip only answers with its enable line up; the stock Y2 contract retries id
+ * reads after power pulses before giving up (5 attempts per tempo/audio.md) */
+#define AW87559_ID_RETRIES	5
+
+/* off-state: mute via SYSCTRL, per the vendor aw87559_off image */
+#define AW87559_SYSCTRL_MUTE	0x30
+
+/* vendor on-image (tempo): every register of the vendor's aw87559_on, SYSCTRL last */
+struct aw87559_reg_sequence {
+	unsigned char reg;
+	unsigned char val;
+};
+
+extern const struct aw87559_reg_sequence aw87559_on_seq[];
+extern const size_t aw87559_on_seq_len;
+extern const struct aw87559_reg_sequence oca72559_on_seq[];
+extern const size_t oca72559_on_seq_len;
+
+/* aud driver glue (yusu_android_speaker.h contract): the audio HAL pokes the amp
+ * through the MT6582 EAMP ioctls — SET/GET_EAMP_PARAMETER land here (D13). */
+int Audio_eamp_command(unsigned int type, unsigned long args, unsigned int count);
+
+#endif /* _AW87559_PA_H_ */
