+		 * self-contained glitch pulse leaves S2 back at the baseline,
+		 * so the reported-relative form would count 0 and §5.5 G2/G3
+		 * plus the §6 attribution metric would be unsatisfiable. */
+		dropped += hweight16(unstable);
