-#define KPD_PMIC_RSTKEY_MAP KEY_VOLUMEDOWN
+/*
+ * D45 (m5 power: phantom-input storm kill) — KPD_PMIC_RSTKEY_MAP ("VOL down on
+ * PMIC fchrkey") is DELETED, deliberately and permanently. The Q5 fchrkey pin
+ * is unwired on this board: D22 PTY evidence places VOLDOWN on matrix slot [1]
+ * (cust_kpd.h keymap {[0]=KEY_VOLUMEUP,[1]=KEY_VOLUMEDOWN}), not on the PMIC
+ * reset key. With the fchrkey IRQ left storming, it produced phantom
+ * KEY_VOLUMEDOWN press/release pairs on event0 while screen-off idle (m5
+ * evidence; the same storm the D22 PMIC evidence chain documented). The
+ * interrupt is likewise dead in power/mt6582/pmic_mt6323.c
+ * (cust_pmic_interrupt_en_setting + PMIC_INIT_SETTING_V1). Both the map and
+ * the IRQ must stay dead — see build/82_kernel_delta_power_audio.sh gates.
+ */
 #define KPD_PMIC_LPRST_TD 1 /* timeout period. 0: 7sec; 1: 11sec; 2: 14sec; 3: 5sec */
 
 #endif
