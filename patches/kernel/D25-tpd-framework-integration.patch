+/* D25 [BLOB 0xc034c2b4 = the vendor's pre-contact link gate, E5] up to
+ * GSL_CHIP_AWAIT_TRIES (5) reads of 4 bytes @GSL_CHIP_AWAIT_REG (0xfc):
+ * 0 on the first success, -1 after 5 failures — the caller aborts the
+ * probe. This is the FIRST chip contact (after power/GPIO/100 ms settle,
+ * with the EINT held masked): the compiled vendor rides the panel's post-
+ * power-on boot window out instead of deciding liveness from a single
+ * read. No inter-retry delay in the blob (r4=#5 loop, bgt early-out). */
+static int gsl_await_chip(struct i2c_client *client)
+{
+	u8 read_buf[4] = {0};
+	int tries = GSL_CHIP_AWAIT_TRIES;
+	int ret;
+
+	while (tries-- > 0) {
+		ret = gsl_read_interface(client, GSL_CHIP_AWAIT_REG, read_buf,
+					 sizeof(read_buf));
+		if (ret == 0)
+			return 0;
+		GSL_LOGE("D25: 0xfc gate read failed (%d), %d tries left\n",
+			 ret, tries);
+	}
+
+	GSL_LOGE("gsl_tp: chip not answering 0xfc after 5 reads\n");
+	return -1;
+}
