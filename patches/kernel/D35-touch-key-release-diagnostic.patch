--- a/drivers/input/touchscreen/mediatek/gslX680/mtk_gslX680.c
+++ b/drivers/input/touchscreen/mediatek/gslX680/mtk_gslX680.c
@@ -162,6 +162,11 @@
 extern void mt_eint_registration(unsigned int eint_num, unsigned int flow,
 				 void (EINT_FUNC_PTR)(void), unsigned int is_auto_umask);
 
+/* Bounded, opt-in raw/processed frame diagnostics. Zero by default. */
+static int debug_frames;
+module_param(debug_frames, int, 0600);
+MODULE_PARM_DESC(debug_frames, "Number of touch frames to log (diagnostic only)");
+
 #define GSL_DEBUG	(0)
 #if GSL_DEBUG
 #define GSL_LOGD(fmt, args...)	printk("gsl_tp:[%04d]%s " fmt, __LINE__, __func__, ##args)
@@ -991,6 +996,8 @@
 
 static void tpd_up(void)
 {
+	/* A virtual key is stateful: every press needs an all-fingers-up release. */
+	tpd_button(0, 0, 0);
 	input_report_key(tpd->dev, BTN_TOUCH, 0);
 	input_mt_sync(tpd->dev);
 }
@@ -1031,6 +1038,7 @@
 	u8 buf[4] = {0};
 	struct gsl_touch_info cinfo;
 	int tmp1;
+	bool debug_frame = debug_frames > 0;
 #endif
 
 	if (gsl_proc_flag == 1)
@@ -1074,7 +1082,16 @@
 	}
 	cinfo.finger_num = (touch_data[3] << 24) | (touch_data[2] << 16) |
 			(touch_data[1] << 8) | touch_data[0];
+	if (debug_frame) {
+		debug_frames--;
+		printk(TPD_DEVICE ": D35 raw=%02x%02x%02x%02x first=%02x%02x%02x%02x cfg=%d\n",
