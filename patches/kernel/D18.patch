+/*
+ * lcm_compare_id — blob 0xc03d14b8: reset pulse high 5 ms / low 25 ms / high 120 ms,
+ * dsi_set_cmdq({0x00033700}, 1, 1) read-setup packet, read_reg_v2(0x04, buffer, 3)
+ * (DCS GET_DISPLAY_ID), id = (buffer[1] << 8) | buffer[2].  This variant accepts
+ * 0x9505 or 0x9506 (blob: id-0x9500 in {0, 1}).
+ */
+static unsigned int lcm_compare_id(void)
+{
+    unsigned int id;
+    unsigned char buffer[3];
+    unsigned int array[1];
+
+    SET_RESET_PIN(1);
+    MDELAY(5);
+    SET_RESET_PIN(0);
+    MDELAY(25);
+    SET_RESET_PIN(1);
+    MDELAY(120);
+
+    array[0] = 0x00033700;
+    dsi_set_cmdq(array, 1, 1);
+    read_reg_v2(0x04, buffer, 3);
+
+    id = (buffer[1] << 8) | buffer[2];
+    LCM_PRINT("gc9503v boe %s,buffer[0]=0x%x,buffer[1]=0x%x,id = 0x%x\n",
+              __func__, buffer[0], buffer[1], id);
+    return (unsigned int)(id == 0x9505 || id == 0x9506);
+}
