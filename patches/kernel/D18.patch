+ * lcm_init — blob 0xc03d1708: SET_RESET_PIN(1) 10 ms, (0) 10 ms, (1) 120 ms,
+ * then the full 43-row initialization table.  lcm_resume is lcm_init
+ * exactly as compiled (blob resume 0xc03d1780 = tail-call to 0xc03d1708).
+ */
+static void lcm_init(void)
+{
+    SET_RESET_PIN(1);
+    MDELAY(10);
+    SET_RESET_PIN(0);
+    MDELAY(10);
+    SET_RESET_PIN(1);
+    MDELAY(120);
+
+    push_table(lcm_initialization_setting,
+               ARY_SIZE(lcm_initialization_setting), 1);
+}
+
+static void lcm_suspend(void)
+{
+    /* blob 0xc03d179c: the 39-row analog power-down table (display off 0x28,
+     * sleep-in 0x10, the 0xf0-unlocked rail sequence), then reset left HIGH
+     * for 50 ms — the Y2Linux corroboration calls this "reset left HIGH
+     * (SET_RESET_PIN(1)) for 50 ms" from an independent stock-binary decode. */
+    push_table(lcm_deep_sleep_mode_in_setting,
+               ARY_SIZE(lcm_deep_sleep_mode_in_setting), 1);
+    SET_RESET_PIN(1);
+    MDELAY(50);
+}
+
+static void lcm_resume(void)
+{
+    lcm_init();
+}
