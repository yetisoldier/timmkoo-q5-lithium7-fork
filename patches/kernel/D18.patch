+/*
+ * lcm_init — blob 0xc03d10d0: SET_RESET_PIN(1) 10 ms, (0) 10 ms, (1) 120 ms,
+ * then the full 49-row initialization table.  lcm_resume is lcm_init
+ * exactly as compiled (blob resume 0xc03d1148 = tail-call to 0xc03d10d0).
+ */
+static void lcm_init(void)
+{
+    SET_RESET_PIN(1);
+    MDELAY(10);
+    SET_RESET_PIN(0);
+    MDELAY(10);
+    SET_RESET_PIN(1);
+    MDELAY(120);
+
+    push_table(lcm_initialization_setting,
+               ARY_SIZE(lcm_initialization_setting), 1);
+}
