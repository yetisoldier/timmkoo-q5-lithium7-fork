              -I$(MTK_PROJECT_PATH_ROOT)/vibrator \
+             -I$(MTK_PROJECT_PATH_ROOT)/dct/dct/inc \
 	     -I$(DRVGEN_OUT)/inc \
              -I$(MTK_PROJECT_PATH_ROOT)/multibridge/mt8193/inc 
 

