  */
 
+/* D20 (bob-m4 §3.2 row 5): the Q5's matrix wiring differs from a106 — the pinned
+ * Lithium blob's compiled kpd_keymap (rodata @0xc08d0e34, 72 u16 entries copied
+ * byte-exact into hal_kpd.c's kpd_keymap[] by kpd_init_keymap @c04a4fa8) carries
+ * { [0] = 114 (KEY_VOLUMEDOWN), [1] = 115 (KEY_VOLUMEUP), 0... } vs the a106
+ * lineage's { [1] = VOLUP, [2] = VOLDOWN }. This copy wins include precedence over
+ * the per-build DrvGen output (mechanism in cust_eint.h's D20 banner); build/62
+ * asserts the map. Blob pwrkey facts re-verified, no change needed:
+ * kpd_set_debounce(1024) @c04a4990 == KPD_KEY_DEBOUNCE 1024; PMIC pwrkey plumbing
+ * is chip-level (MT6323), kpd_pwrkey_pmic_handler @c04a4af4 present as in the
+ * fork. The KPD_DL_KEY / MT65XX_RECOVERY_KEY macros (LK-side contracts, no
+ * kernel consumer) and the LPRST flag block (blob compiles it OUT) left as the
+ * a106 lineage. */
+
 #ifndef _CUST_KPD_H_
 #define _CUST_KPD_H_
 #include <linux/input.h>
@@ -60,11 +73,14 @@
 #define KPD_PWRKEY_MAP    KEY_POWER
 #define MTK_PMIC_PWR_KEY    8
 
-/* HW keycode [0 ~ 71] -> Linux keycode */
+/* HW keycode [0 ~ 71] -> Linux keycode. D20: Q5 wiring per the pinned Lithium
+ * blob's compiled kpd_keymap @0xc08d0e34 ({[0]=VOLDOWN,[1]=VOLUP}); the a106
+ * lineage shifted the pair by one ([1]=VOLUP,[2]=VOLDOWN) — on the Q5 that would
+ * read the matrix pads one-off (VOL+/- never emitted). */
 #define KPD_INIT_KEYMAP()	\
 {	\
+	[0] = KEY_VOLUMEDOWN,		\
 	[1] = KEY_VOLUMEUP,		\
-	[2] = KEY_VOLUMEDOWN,		\
