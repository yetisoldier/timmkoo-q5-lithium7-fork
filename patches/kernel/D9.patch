+/*************************************************************************
+* FUNCTION
+*    set_gain
+*
+* DESCRIPTION
+*    This function is to set global gain to sensor.
+*
+* PARAMETERS
+*    iGain : sensor global gain(base: 0x40)
+*
+* RETURNS
+*    the actually gain set to sensor.
+*
+* GLOBALS AFFECTED
+*
+*************************************************************************/
+static kal_uint16 set_gain(kal_uint16 gain)
+{
+#define ANALOG_GAIN_1 64  // 1.00x
+#define ANALOG_GAIN_2 90  //1.37x
+#define ANALOG_GAIN_3 128  // 1.89x
+#define ANALOG_GAIN_4 178  // 2.59x
+#define ANALOG_GAIN_5 247  // 3.70x
+#define ANALOG_GAIN_6 332  // 5.06x
+#define ANALOG_GAIN_7 435  // 7.15x
+			
+	kal_uint16 iReg,temp,temp1; 	
+	
+	iReg = gain;
+	
+	if(iReg < 0x40)
+		iReg = 0x40;
+	if(iReg > 512)
+		iReg = 512;
+		
+	if((ANALOG_GAIN_1<= iReg)&&(iReg < ANALOG_GAIN_2))
+	{
+			//analog gain
+			write_cmos_sensor(0xb6, 0x00);// 
+			temp = iReg;
+			write_cmos_sensor(0xb1, temp>>6);
+			write_cmos_sensor(0xb2, (temp<<2)&0xfc);
+//			LOG_INF("GC5004 analogic gain 1x , GC5004 add pregain = %d\n",temp);
+		
+	}
+	else if((ANALOG_GAIN_2<= iReg)&&(iReg < ANALOG_GAIN_3))
+	{
+			//analog gain
+			write_cmos_sensor(0xb6, 0x01);// 
+			temp = 64*iReg/ANALOG_GAIN_2;
+			write_cmos_sensor(0xb1, temp>>6);
+			write_cmos_sensor(0xb2, (temp<<2)&0xfc);
+//			LOG_INF("GC5004 analogic gain 1.45x , GC5004 add pregain = %d\n",temp);
+		
+	}
+	
+	else if((ANALOG_GAIN_3<= iReg)&&(iReg < ANALOG_GAIN_4))
+	{
+			//analog gain
+			write_cmos_sensor(0xb6, 0x02);//
+			temp = 64*iReg/ANALOG_GAIN_3;
+			write_cmos_sensor(0xb1, temp>>6);
+			write_cmos_sensor(0xb2, (temp<<2)&0xfc);
+//			LOG_INF("GC5004 analogic gain 2.02x , GC5004 add pregain = %d\n",temp); 
+	}
+	
+	else if((ANALOG_GAIN_4<= iReg)&&(iReg < ANALOG_GAIN_5))
+	{
+			//analog gain
+			write_cmos_sensor(0xb6, 0x03);//
+			temp = 64*iReg/ANALOG_GAIN_4;
+			write_cmos_sensor(0xb1, temp>>6);
+			write_cmos_sensor(0xb2, (temp<<2)&0xfc);
+			
+//			LOG_INF("GC5004 analogic gain 2.8x, temp = %d\n", temp);
+	}
+	else if(ANALOG_GAIN_5<= iReg)
+	{
+			//analog gain
+			write_cmos_sensor(0xb6, 0x04);//
+			temp = 64*iReg/ANALOG_GAIN_5;
+			write_cmos_sensor(0xb1, temp>>6);
+			write_cmos_sensor(0xb2, (temp<<2)&0xfc);
+			
+//			LOG_INF("GC5004 analogic gain 2.8x, temp = %d\n", temp);
+	}
+
+	
+	return gain;
+
+}    /*    set_gain  */
