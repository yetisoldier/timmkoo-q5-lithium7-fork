+
+    pSensorInfo->CaptureDelayFrame = 4; 
+    pSensorInfo->PreviewDelayFrame = 4;//10; 
+    pSensorInfo->VideoDelayFrame = 0; 
+    pSensorInfo->SensorMasterClockSwitch = 0; 
+    pSensorInfo->SensorDrivingCurrent = ISP_DRIVING_8MA;   	
