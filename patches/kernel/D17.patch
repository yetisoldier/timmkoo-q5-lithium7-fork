+/* [BLOB check_mem_data] reads reg 0xb0; byte 0 == 0x5a means firmware alive,
+ * anything else schedules the full sw_init (fingerprint autodetect). */
+static int check_mem_data(struct i2c_client *client)
+{
+	u8 read_buf[4] = {0};
+	int result = 0;
+
+	GSL_LOGF();
+
+	gsl_i2c_read_bytes(client, GSL_REG_MEM_CHECK, read_buf, sizeof(read_buf));
+	if (read_buf[0] != 0x5a) {
+		GSL_LOGD("mem check %02x%02x%02x%02x != alive — full init\n",
+			 read_buf[0], read_buf[1], read_buf[2], read_buf[3]);
+		gsl_sw_init(client);
+	}
+	return result;
+}
