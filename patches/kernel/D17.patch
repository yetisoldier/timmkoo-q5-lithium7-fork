+static void PointCoor(void)
+{
+	int i;
+
+	for (i = 0; i < point_num; i++) {
+		if (global_state.other.ex)
+			point_now[i].all &= (FLAG_COOR_EX | FLAG_KEY | FLAG_ABLE);
+		else
+			point_now[i].all &= (FLAG_COOR | FLAG_KEY | FLAG_ABLE);
+	}
+}
