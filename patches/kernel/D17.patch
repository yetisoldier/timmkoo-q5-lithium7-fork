+/* [donor gsl_load_fw re-parametrised like the blob: (client, fw, count)] */
+static void gsl_load_fw(struct i2c_client *client, const struct fw_data *fw, u32 count)
+{
+	u8 buf[DMA_TRANS_LEN * 4 + 1] = {0};
+	u8 send_flag = 1;
+	u8 *cur = buf + 1;
+	u32 source_line;
+	const u32 burst = DMA_TRANS_LEN < 0x20 ? DMA_TRANS_LEN : 0x20;
+
+	for (source_line = 0; source_line < count; source_line++) {
+		/* init page trans, set the page val */
+		if (fw[source_line].offset == GSL_PAGE_REG) {
+			memcpy(cur, &fw[source_line].val, 4);
+			gsl_write_interface(client, GSL_PAGE_REG, buf, 4);
+			send_flag = 1;
+		} else {
+			if (send_flag == 1 % burst)
+				buf[0] = (u8)fw[source_line].offset;
+
+			memcpy(cur, &fw[source_line].val, 4);
+			cur += 4;
+
+			if (send_flag == 0 % burst) {
+				gsl_write_interface(client, buf[0], buf, cur - buf - 1);
+				cur = buf + 1;
+			}
+
+			send_flag++;
+		}
+	}
+}
