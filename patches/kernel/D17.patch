+# D17 — gsl_tp (Silead gslX68X family) touch driver for the TIMMKOO Q5.
+# Structure follows the in-tree mediatek touch dirs (ft5336/gt9xx) and the
+# donor's own Makefile (oxygen gslX68X): point-id unit + driver unit.
+include $(srctree)/drivers/misc/mediatek/Makefile.custom
+
+MTK_PLATFORM := $(subst ",,$(CONFIG_MTK_PLATFORM))
+
+subdir-ccflags-y += -I$(srctree)/drivers/misc/mediatek/include
+subdir-ccflags-y += -I$(srctree)/drivers/misc/mediatek/include/mt-plat/$(MTK_PLATFORM)/include
+subdir-ccflags-y += -I$(srctree)/drivers/misc/mediatek/include/mt-plat
+# board glue (tpd_custom_gsl_tp.h) lives in the q5 board touchpanel dir
+ccflags-y += -I$(srctree)/arch/arm/mach-mt6582/$(ARCH_MTK_PROJECT)/touchpanel/gsl_tp/
+ccflags-y += -I$(srctree)/drivers/input/touchscreen/mediatek/
+
+obj-y	+=  gsl_point_id.o
+obj-y	+=  mtk_gslX680.o
