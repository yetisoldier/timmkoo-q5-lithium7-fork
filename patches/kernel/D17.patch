+/* ------------------------------------------------------------------ */
+/* [BLOB gsl_sw_init — exact port of the disassembled selection logic]
+ *
+ *  1. hardware reset pulse: GPIO14 mode0/output, low 20 ms → high 20 ms
+ *  2. gsl_test_i2c; bail out on failure (state stays uninitialised)
+ *  3. while no config has been selected yet: up to 3 attempts of
+ *     clear-reg → reset-core → load GSL_TP_CHECK_FW (957 entries) →
+ *     start-core → sleep 200 ms → read reg 0xb4; (buf[2]|buf[3]<<8) > 1
+ *     means the canary array answered → proceed to autodetect.
+ *     Three failures → jump to the default firmware load (config 0).
+ *  4. autodetect: sleep 20 ms, read the fingerprint from 0xb8, print it,
+ *     score it against gsl_fp_table:
+ *         score_i = 100 * popcount(fp_i & ~fp) + popcount(fp_i ^ fp)
+ *     (decoded from the blob's popcount blocks, incl. the gcc constant
+ *     folds: ~fp_i is encoded as bic-constant pairs).  Lowest score wins,
+ *     first match in cascade order (config ids 1..6); 6 = JX_2 = no match.
+ *  5. load the selected config: clear → reset → io_control → load_fw →
+ *     io_control → start core.  Banner print per the blob's cascade:
+ *     1/4 → DSJ, 2/5/unknown → HW, 3 → WL, 6 → JX_2.
+ */
+static int gsl_sw_init(struct i2c_client *client)
+{
+	u8 buf[4] = {0};
+	u32 fingerprint;
+	int score[6];
+	int try_count;
+	int i, best;
+	const struct gsl_cfg_config *cfg;
+
+	if (gsl_dev.sw_inited)
+		return 0;
+
+	/* 1. reset pulse [BLOB mt_set_gpio_out(0x8000000E, 0/1) + msleep(20)×2] */
+	mt_set_gpio_mode(GPIO_CTP_RST_PIN, GPIO_CTP_RST_PIN_M_GPIO);
+	mt_set_gpio_dir(GPIO_CTP_RST_PIN, GPIO_DIR_OUT);
+	mt_set_gpio_out(GPIO_CTP_RST_PIN, GPIO_OUT_ZERO);
+	msleep(20);
+	mt_set_gpio_out(GPIO_CTP_RST_PIN, GPIO_OUT_ONE);
+	msleep(20);
+
+	/* 2. link test */
+	if (gsl_test_i2c(client) < 0) {
+		GSL_LOGE("gsl_test_i2c failed\n");
+		return -1;
+	}
+
+	/* 3. check-firmware canary stage */
+	if (gsl_dev.config_id == 0) {
+		try_count = 3;
+		while (try_count--) {
+			gsl_clear_reg(client);
+			gsl_reset_core(client);
+			gsl_load_fw(client, GSL_TP_CHECK_FW, ARRAY_SIZE(GSL_TP_CHECK_FW));
+			gsl_start_core(client);
+			msleep(200);
+			gsl_i2c_read_bytes(client, 0xb4, buf, sizeof(buf));
+			if ((buf[2] | (buf[3] << 8)) > 1)
+				break;		/* canary answered */
+			GSL_LOGD("canary not answered, %d tries left\n", try_count);
+		}
+		if (try_count < 0) {
+			GSL_LOGD("3/3 canary failures — default config\n");
+			goto load_cfg;	/* config_id stays 0 → HW firmware */
+		}
+	}
+
+	/* 4. fingerprint autodetect [BLOB: msleep(20) + read 0xb8 + 6 popcounts] */
+	msleep(20);
+	gsl_i2c_read_bytes(client, GSL_REG_FINGERPRINT, buf, sizeof(buf));
+	fingerprint = buf[0] | (buf[1] << 8) | (buf[2] << 16) | ((u32)buf[3] << 24);
+	printk(TPD_DEVICE ": the test 0xb8 = {0x%02x%02x%02x%02x}\n",
+	       buf[0], buf[1], buf[2], buf[3]);
+
+	for (i = 0; i < 6; i++) {
+		score[i] = 100 * hweight32(gsl_fp_table[i] & ~fingerprint)
+			   + hweight32(gsl_fp_table[i] ^ fingerprint);
+		GSL_LOGD("fp[%d]=%08x score=%d\n", i + 1, gsl_fp_table[i], score[i]);
+	}
+	best = 0;
+	for (i = 1; i < 6; i++)
+		if (score[i] < score[best])
+			best = i;
+	gsl_dev.config_id = best + 1;
+
+load_cfg:
+	/* banner + cfg-index mapping [BLOB cascade order: 2→HW, 1/4→DSJ,
+	 * 3→WL, 6→JX_2, default(0/5)→HW] */
+	switch (gsl_dev.config_id) {
+	case 1:
+	case 4:
+		printk("------GSLX680_FW_DSJ------\n");
+		gsl_dev.config_id = 1;
+		break;
+	case 2:
+	case 0:
+	case 5:
+		printk("------GSLX680_FW_HW------\n");
+		gsl_dev.config_id = 0;
+		break;
+	case 3:
+		printk("------GSLX680_FW_WL------\n");
+		gsl_dev.config_id = 2;
+		break;
+	case 6:
+		printk("------GSLX680_FW_JX_2------\n");
+		gsl_dev.config_id = 4;
+		break;
+	default:
+		printk("------GSLX680_FW_HW------\n");
+		gsl_dev.config_id = 0;
+		break;
+	}
+
+	/* 5. download the selected firmware (blob order incl. io_control×2) */
+	cfg = &gsl_cfg_table[gsl_dev.config_id % 5];
+	gsl_clear_reg(client);
+	gsl_reset_core(client);
+	gsl_io_control(client);
+	gsl_load_fw(client, cfg->fw, cfg->fw_size);
+	gsl_io_control(client);
+	gsl_start_core(client);
+
+	printk(TPD_DEVICE ": gsl_sw_init done, config %d\n", gsl_dev.config_id);
+	return 0;
+}
