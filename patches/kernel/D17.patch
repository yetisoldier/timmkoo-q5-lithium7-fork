+static void PointPointer(void)
+{
+	int i, pn;
+
+	point_n++;
+	if (point_n >= PP_DEEP * PS_DEEP * PR_DEEP * PRESSURE_DEEP)
+		point_n = 0;
+	pn = point_n % PP_DEEP;
+	for (i = 0; i < PP_DEEP; i++) {
+		pp[i] = point_array[pn];
+		if (pn == 0)
+			pn = PP_DEEP - 1;
+		else
+			pn--;
+	}
+	pn = point_n % PS_DEEP;
+	for (i = 0; i < PS_DEEP; i++) {
+		ps[i] = point_array[pn+PP_DEEP];
+		if (pn == 0)
+			pn = PS_DEEP - 1;
+		else
+			pn--;
+	}
+	pn = point_n % PR_DEEP;
+	for (i = 0; i < PR_DEEP; i++) {
+		pr[i] = point_array[pn+PP_DEEP+PS_DEEP];
+		if (pn == 0)
+			pn = PR_DEEP - 1;
+		else
+			pn--;
+	}
+	pn = point_n % PRESSURE_DEEP;
