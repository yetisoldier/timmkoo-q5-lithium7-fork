+/* ------------------------------------------------------------------ */
+/* power / gpio / eint wiring ([BLOB])                                 */
+/* ------------------------------------------------------------------ */
+
+static void gsl_power_on(void)
+{
+	/* [BLOB probe] VIO28 @1.8 V (IO) + VGP1 @2.8 V (analog), consumer tag
+	 * "TP".  The blob fires each rail twice with both PMIC enum spellings
+	 * of the same regulator; powering each rail once is equivalent. */
+	if (!hwPowerOn(TPD_POWER_SOURCE_1800, VOL_1800, TPD_POWER_USER_NAME))
+		GSL_LOGE("power on VIO28 1.8V failed\n");
+	if (!hwPowerOn(TPD_POWER_SOURCE_2800, VOL_2800, TPD_POWER_USER_NAME))
+		GSL_LOGE("power on VGP1 2.8V failed\n");
+}
+
+static void gsl_gpio_init(void)
+{
+	/* [BLOB probe] reset GPIO14 → mode0/output/low; INT GPIO2 → mode0/
+	 * input, pull-up.  Same constants as the blob (0x8000000E /
+	 * 0x80000002 board-encoded == GPIO_CTP_RST_PIN / GPIO_CTP_EINT_PIN). */
+	mt_set_gpio_mode(GPIO_CTP_RST_PIN, GPIO_CTP_RST_PIN_M_GPIO);
+	mt_set_gpio_dir(GPIO_CTP_RST_PIN, GPIO_DIR_OUT);
+	mt_set_gpio_out(GPIO_CTP_RST_PIN, GPIO_OUT_ZERO);
+	msleep(20);
+	mt_set_gpio_out(GPIO_CTP_RST_PIN, GPIO_OUT_ONE);
+
+	mt_set_gpio_mode(GPIO_CTP_EINT_PIN, GPIO_CTP_EINT_PIN_M_GPIO);
+	mt_set_gpio_dir(GPIO_CTP_EINT_PIN, GPIO_DIR_IN);
+	mt_set_gpio_pull_enable(GPIO_CTP_EINT_PIN, GPIO_PULL_ENABLE);
+	mt_set_gpio_pull_select(GPIO_CTP_EINT_PIN, GPIO_PULL_UP);
+}
+
+static void gsl_eint_register(void)
+{
+	/* [BLOB probe] mt_eint_registration(2, flag=RISING, handler, auto=1) */
+	mt_eint_registration(CUST_EINT_TOUCH_PANEL_NUM, TPD_EINT_FLOW,
+			     tpd_eint_interrupt_handler, 1);
+	mt_eint_unmask(CUST_EINT_TOUCH_PANEL_NUM);
+}
+
+/* ------------------------------------------------------------------ */
+/* tpd driver glue                                                     */
+/* ------------------------------------------------------------------ */
+
+static int tpd_local_init(void)
+{
+	GSL_LOGF();
+
+	gsl_power_on();
+
+	if (i2c_add_driver(&tpd_i2c_driver) != 0) {
+		GSL_LOGE("unable to add i2c driver.\n");
+		return -1;
+	}
+
+	if (tpd_load_status == 0) {
+		GSL_LOGE("add error touch panel driver.\n");
+		i2c_del_driver(&tpd_i2c_driver);
+		return -1;
+	}
+
+	input_set_abs_params(tpd->dev, ABS_MT_TRACKING_ID, 0, (MAX_CONTACTS + 1), 0, 0);
+
+	tpd_type_cap = 1;
+	GSL_LOGD("tpd_local_init is ok.\n");
+	return 0;
+}
+
+/* low-power suspend/resume ([BLOB gsl_suspend/gsl_resume] via earlysuspend) */
+static void tpd_suspend(struct early_suspend *h)
+{
+	if (gsl_dev.halt == 1)
+		return;
+
+	gsl_dev.halt = 1;
+
+	mt_eint_mask(CUST_EINT_TOUCH_PANEL_NUM);
+	mt_set_gpio_out(GPIO_CTP_RST_PIN, GPIO_OUT_ZERO);
+	msleep(20);
+}
+
+static void tpd_resume(struct early_suspend *h)
+{
+	struct i2c_client *client = gsl_dev.client;
+
+	if (gsl_dev.halt == 0) {
+		GSL_LOGD("already in resumed status\n");
+		return;
+	}
+	gsl_dev.halt = 0;
+
+	mt_set_gpio_out(GPIO_CTP_RST_PIN, GPIO_OUT_ONE);
+	msleep(20);
+	gsl_reset_core(client);
+	gsl_start_core(client);
+	msleep(20);
+	check_mem_data(client);
+
+	mt_eint_unmask(CUST_EINT_TOUCH_PANEL_NUM);
+}
+
+static int tpd_i2c_probe(struct i2c_client *client, const struct i2c_device_id *id)
+{
+	int ret;
+
+	GSL_LOGF();
+
+	gsl_power_on();
+	gsl_gpio_init();
+
+	i2c_client = client;
+	gsl_dev.client = client;
+
+	/* bring the controller up (cold start runs the fingerprint autodetect) */
+	ret = check_mem_data(client);
+	if (ret < 0) {
+		GSL_LOGE("Failed to init chip!\n");
+		return -1;
+	}
+
+	gsl_eint_register();
+
+	thread = kthread_run(touch_event_handler, 0, TPD_DEVICE);
+	if (IS_ERR(thread)) {
+		ret = PTR_ERR(thread);
+		printk(TPD_DEVICE ": failed to create kernel thread: %d\n", ret);
+		return ret;
+	}
+
+	tpd_load_status = 1;
+
+#ifdef TPD_PROC_DEBUG
+	proc_create(GSL_CONFIG_PROC_FILE, 0660, NULL, &gsl_seq_fops);
+	gsl_proc_flag = 0;
+#endif
+	gsl_dev.halt = 0;
+
+	GSL_LOGD("probe ok: config %d\n", gsl_dev.config_id);
+	return 0;
+}
+
+static int tpd_i2c_remove(struct i2c_client *client)
+{
+	GSL_LOGD("remove\n");
+	kthread_stop(thread);
+	mt_eint_mask(CUST_EINT_TOUCH_PANEL_NUM);
+	return 0;
+}
+
+static int tpd_i2c_detect(struct i2c_client *client, struct i2c_board_info *info)
+{
+	/* accept any matched legacy address; board info normally binds us */
+	strcpy(info->type, GSLX680_NAME);
+	return 0;
+}
+
+/* [BLOB] id aliases the silead family carries: "gsl_tp" first (exact match
+ * with the blob's gsl_device_id string = the live 0-0040 binding); the
+ * "gsl1680" / "gsl915" aliases exist in the blob's rodata beside the
+ * driver. */
+static const struct i2c_device_id tpd_i2c_id[] = {
+	{ GSLX680_NAME, 0 },
+	{ "gsl1680", 0 },
+	{ "gsl915", 0 },
+	{}
+};
+
+static unsigned short force[] = { GSLX680_ADDR, I2C_CLIENT_END, I2C_CLIENT_END };
+static const unsigned short *const forces[] = { force, NULL };
+
+static struct i2c_driver tpd_i2c_driver = {
+	.driver = {
+		.name = GSLX680_NAME,
+	},
+	.probe = tpd_i2c_probe,
+	.remove = tpd_i2c_remove,
+	.detect = tpd_i2c_detect,
+	.id_table = tpd_i2c_id,
+	.address_list = (const unsigned short *)forces,
+};
+
+static struct i2c_board_info __initdata gsl_tp_i2c_tpd = {
+	I2C_BOARD_INFO(GSLX680_NAME, (GSLX680_ADDR))
+};
+
+static struct tpd_driver_t tpd_device_driver = {
+	.tpd_device_name = GSLX680_NAME,
+	.tpd_local_init = tpd_local_init,
+	.suspend = tpd_suspend,
+	.resume = tpd_resume,
+#ifdef TPD_HAVE_BUTTON
+	.tpd_have_button = 1,
+#else
+	.tpd_have_button = 0,
+#endif
+};
