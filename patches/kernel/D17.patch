# D17 — port the GSL touch driver (gsl_tp / Silead GSL1680 family) for the TIMMKOO Q5
# Spec: GAP-1 close, bob-m2-spec §1.4; hermes-release-plan hard gate ("no flash without touch").
# Forge D17 (audit trail in .specs/forge-d17-report.md).
#
# Donor: carlitros900/android_kernel_archos_oxygen @ ed79b470265fc4d997de8c7be020792322c8b4dc
#   drivers/input/touchscreen/mediatek/gslX68X/mtk_gslX680.c (public gslX68X MTK-tpd driver)
#   + gsl_point_id_point_active_pen_no_gesture.c -> gsl_point_id.c + Makefile (structure).
#   Priority donors carry no gsl driver: selene = Makefile stub only, sprout/persimmon/e5fhd
#   have ektf2k/Goodix/GT/ft families only.  No public tree has the Q5's multi-config
#   firmware variant (Sourcegraph global: GSLX680_FW_DSJ / GSLX68X_FW_JX = 0 hits).
#
# Q5 ground truth (pinned Lithium blob 5217dd41... / decomp d284ba16..., decoded by
# build/extract_gsl_fw_from_blob.py + objdump forensics, documented in the report):
#   - panel firmware = 5 config arrays (blob gsl_cfg_table[5] @VA 0xc0884a64: HW 5049,
#     DSJ 4851, WL 4983, cfg5 4983, JX_2 4983 entries) + GSL_TP_CHECK_FW canary (957)
#     + 5x512-word tuning buffers -> generated into gslX680_fw_q5.h / gslX680_key_q5.h
#     (byte-exact extraction, tiling-verified).
#   - driver identity: i2c driver/board name "gsl_tp" (blob gsl_device_id string), aliases
#     "gsl1680"/"gsl915" (blob rodata); bus 0 addr 0x40 (board-info table @VA 0xc0b0af98,
#     matches the live 0-0040 gsl_tp device).
#   - wiring: reset GPIO14 = GPIO_CTP_RST_PIN, INT GPIO2 pull-up = GPIO_CTP_EINT_PIN
#     (blob mt_set_gpio_out(0x8000000E/0x80000002, ...) — both pins already declared in
#     the a106/q5 lineage cust_gpio_usage.h with the exact same values; file NOT modified),
#     EINT channel 2 RISING (blob mt_eint_registration(2, flag=1); cust_eint.h already
#     carries CUST_EINT_TOUCH_PANEL_NUM=2 — the a106-clone TYPE default (FALLING) is that
#     board's FT-panel default and is overridden per-driver via TPD_EINT_FLOW), power
#     VIO28@1.8V + VGP1@2.8V tag "TP" (blob hwPowerOn ids 25/31 = MT65XX_POWER_LDO_VIO28/
#     VGP1), firmware fingerprint autodetect on reg 0xb8 (6 constants, min-score cascade.
#     The chip itself reports the fingerprint, so the port needs no compile-time choice).
#   - tpd glue: this 3.10.54 tree has NO CONFIG_CUSTOM_KERNEL_TOUCHPANEL symbol at all
#     (dir selection = CONFIG_TOUCHSCREEN_MTK_*; in-tree convention of self-registered
#     i2c board info + tpd_driver_add, as the ft5336/gt9xx drivers do).  The task's
#     "tpd_custom.c/tpd_default.c registration" maps onto this tree's actual mechanism:
#     arch/arm/mach-mt6582/q5/touchpanel/gsl_tp/tpd_custom_gsl_tp.h board glue + driver
#     self-registration.  The shared tpd_default.c stays untouched (a106-clone dummy).
#
# Parity gates (build/60_kernel_delta_touch.sh): the new blob must contain
# gsl_tp/gsl1680/gslX680 strings and must NOT regress the m1b-beta set.
--- /dev/null
+++ b/arch/arm/mach-mt6582/q5/touchpanel/gsl_tp/tpd_custom_gsl_tp.h
@@ -0,0 +1,43 @@
+/*
+ * tpd_custom_gsl_tp.h — TIMMKOO Q5 board glue for the gsl_tp touch panel (D17).
+ *
+ * Spec: D17 (GAP-1 close), bob-m2-spec §1.4 (board-config translation model).
+ * Everything below is EVIDENCE-LOCKED to the pinned Lithium kernel blob
+ * (5217dd41…, decomp d284ba16…) — the only build that ships a working driver
+ * for this panel — cross-checked against the live Mint I2C map:
+ *
+ *   I2C       bus 0, addr 0x40          blob: board-info entry { "gsl_tp", .addr = 0x40 } (mt_devs i2c-0
+ *                                       table at VA 0xc0b0af98) + live device 0-0040 gsl_tp
+ *   driver    "gsl_tp"                  blob: gsl_device_id symbol = "gsl_tp" string (i2c_device_id)
+ *   reset     GPIO14 (0x8000000E)       blob: mt_set_gpio_mode/dir/out(0x8000000E, …) in probe/init;
+ *                                       == GPIO_CTP_RST_PIN (GPIO14 | 0x80000000) of cust_gpio_usage.h
+ *   INT       GPIO2, pull-up (0x80000002)
+ *                                       blob: mt_set_gpio_mode/dir/pull-enable/pull-up(0x80000002, …);
+ *                                       == GPIO_CTP_EINT_PIN (GPIO2 | 0x80000000) of cust_gpio_usage.h
+ *   EINT      channel 2, rising edge    blob: mt_eint_registration(2, 1 = EINTF_TRIGGER_RISING, …);
+ *                                       cust_eint.h CUST_EINT_TOUCH_PANEL_NUM already = 2
+ *   power     VIO28@1.8 V + VGP1@2.8 V  blob: hwPowerOn(reg=25, 1800, "TP") + hwPowerOn(reg=31, 2800, "TP")
+ *                                       (MT65XX_POWER_LDO_VIO28 = 25, MT65XX_POWER_LDO_VGP1 = 31)
+ *   fw        5 configs + check-fw      blob: gsl_cfg_table[5] @VA 0xc0884a64 (extracted into
+ *                                       drivers/input/touchscreen/mediatek/gslX680/gslX680_fw_q5.h)
+ */
+#ifndef _TPD_CUSTOM_GSL_TP_H_
+#define _TPD_CUSTOM_GSL_TP_H_
+
+/* i2c device: the Q5's panel binds /sys/bus/i2c/devices/0-0040 as "gsl_tp" */
+#define TPD_I2C_NUMBER			0
+#define GSLX680_NAME			"gsl_tp"
+#define GSLX680_ADDR			0x40
+
+/* power rails (see header comment; "TP" consumer tag = blob's own) */
+#define TPD_POWER_SOURCE_1800		MT65XX_POWER_LDO_VIO28
+#define TPD_POWER_SOURCE_2800		MT65XX_POWER_LDO_VGP1
+#define TPD_POWER_USER_NAME		"TP"
+
+/* EINT flow from the blob's compiled mt_eint_registration arg
+ * (flag = 1 = EINTF_TRIGGER_RISING; cust_eint.h's CUST_EINT_TOUCH_PANEL_TYPE
+ * is the a106 clone's FT-panel default (FALLING) and is corrected for the Q5
+ * by this macro — the D17 patch rewires it at the board level). */
+#define TPD_EINT_FLOW			EINTF_TRIGGER_RISING
+
+#endif /* _TPD_CUSTOM_GSL_TP_H_ */
