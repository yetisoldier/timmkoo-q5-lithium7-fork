+/* ------------------------------------------------------------------ */
+/* chip helpers (donor bodies unless [BLOB]-annotated)                  */
+/* ------------------------------------------------------------------ */
+
+static int gsl_test_i2c(struct i2c_client *client)
+{
+	u8 read_buf[4] = {0};
+	u8 write_buf[4] = {0, 0x03, 0x02, 0x01};
+	int result = 0;
+
+	GSL_LOGF();
+
+	result = gsl_i2c_read_bytes(client, 0xf0, read_buf, sizeof(read_buf));
+	usleep_range(2000, 2100);
+	result += gsl_i2c_write_bytes(client, 0xf0, write_buf, sizeof(write_buf));
+	usleep_range(2000, 2100);
+	result += gsl_i2c_read_bytes(client, 0xf0, read_buf, sizeof(read_buf));
+
+	if (memcmp(write_buf, read_buf, 3)) {
+		GSL_LOGE("i2c test mismatch: sent %02x%02x%02x read %02x%02x%02x\n",
+			 write_buf[2], write_buf[1], write_buf[0],
+			 read_buf[2], read_buf[1], read_buf[0]);
+		result--;
+	}
+	return result;
+}
+
+static void gsl_clear_reg(struct i2c_client *client)
+{
+	u8 write_buf[4] = {0};
+
+	GSL_LOGF();
+
+	write_buf[0] = 0x88;
+	gsl_i2c_write_bytes(client, 0xe0, &write_buf[0], 1);
+	msleep(20);
+
+	write_buf[0] = 0x03;
+	gsl_i2c_write_bytes(client, 0x80, &write_buf[0], 1);
+	usleep_range(5000, 5100);
+
+	write_buf[0] = 0x04;
+	gsl_i2c_write_bytes(client, 0xe4, &write_buf[0], 1);
+	usleep_range(5000, 5100);
+
+	write_buf[0] = 0x00;
+	gsl_i2c_write_bytes(client, 0xe0, &write_buf[0], 1);
+	msleep(20);
+}
+
+static int gsl_reset_core(struct i2c_client *client)
+{
+	u8 write_buf[4] = {0};
+	int ret = 0;
+
+	write_buf[0] = 0x88;
+	ret = gsl_i2c_write_bytes(client, 0xe0, &write_buf[0], 1);
+	msleep(20);
+
+	write_buf[0] = 0x04;
+	ret += gsl_i2c_write_bytes(client, 0xe4, &write_buf[0], 1);
+	usleep_range(10000, 11000);
+
+	write_buf[0] = 0x00;
+	write_buf[1] = 0x00;
+	write_buf[2] = 0x00;
+	write_buf[3] = 0x00;
+	ret += gsl_i2c_write_bytes(client, 0xbc, write_buf, 4);
+	usleep_range(10000, 11000);
+
+	if (ret < 0)
+		GSL_LOGE("reset_core fail!\n");
+	return ret;
+}
+
+static void gsl_io_control(struct i2c_client *client)
+{
+	u8 buf[4] = {0};
+	int i;
+
+	for (i = 0; i < 5; i++) {
+		buf[0] = 0;
+		buf[1] = 0;
+		buf[2] = 0xfe;
+		buf[3] = 0x1;
+		gsl_i2c_write_bytes(client, 0xf0, buf, 4);
+		buf[0] = 0x5;
+		buf[1] = 0;
+		buf[2] = 0;
+		buf[3] = 0x80;
+		gsl_i2c_write_bytes(client, 0x78, buf, 4);
+		usleep_range(5000, 5100);
+	}
+	msleep(50);
+}
+
+/* [BLOB gsl_start_core @c034c7d0] 4-byte zero write to 0xe0, then
+ * gsl_DataInit on the active config's tuning words (no sleeps at all). */
+static void gsl_start_core(struct i2c_client *client)
+{
+	u8 write_buf[4] = {0};
+
+	gsl_i2c_write_bytes(client, 0xe0, write_buf, 4);
+#ifdef GSL_NOID_VERSION
+	gsl_DataInit(gsl_cfg_data());
+#endif
+}
