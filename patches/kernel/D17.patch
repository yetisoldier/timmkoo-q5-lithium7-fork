+	/* ------------------------------------------------------------------------- */
+	for (i = 0; i < POINT_MAX; i++) {
+		pp[0][i].all = 0;
+		ps[0][i].all = 0;
+		pr[0][i].all = 0;
+		pa[0][i] = 0;
+	}
+}
