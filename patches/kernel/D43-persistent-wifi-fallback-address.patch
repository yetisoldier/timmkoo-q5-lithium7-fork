 /*----------------------------------------------------------------------------*/
+/* Q5 devices without a programmed MAC must not derive it from uptime.
+ * Read a per-device, locally administered fallback created once by init.
+ * Factory NVRAM/eFUSE addresses still take precedence. Never write NVRAM.
+ */
+static BOOLEAN
+q5ReadPersistentNetworkAddress(PARAM_MAC_ADDRESS *prMacAddr)
+{
+    struct file *file;
+    mm_segment_t oldfs;
+    loff_t offset = 0;
+    UINT_8 address[MAC_ADDR_LEN + 1];
+    ssize_t count;
+
+    oldfs = get_fs();
+    set_fs(get_ds());
+    file = filp_open("/data/misc/wifi/q5-stable-mac", O_RDONLY | O_NOFOLLOW, 0);
+    if (IS_ERR(file)) {
+        set_fs(oldfs);
+        return FALSE;
+    }
+    count = vfs_read(file, (char *)address, sizeof(address), &offset);
+    filp_close(file, NULL);
+    set_fs(oldfs);
+
+    /* Reject truncation, trailing bytes, multicast and globally assigned data. */
+    if (count != MAC_ADDR_LEN || (address[0] & 0x03) != 0x02)
+        return FALSE;
+    kalMemCopy(prMacAddr, address, MAC_ADDR_LEN);
+    return TRUE;
+}
