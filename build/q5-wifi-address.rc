# Complete before Android's Wi-Fi service can power up the driver.
on post-fs-data
    exec u:r:su:s0 root root -- /system/bin/sh /system/etc/q5-wifi-address.sh

# A bounded startup helper; exits on connection and is never kept resident.
service q5-wifi-retry /system/bin/sh /system/etc/q5-wifi-reconnect.sh
    class main
    user root
    group root system wifi
    seclabel u:r:su:s0
    disabled
    oneshot

on property:init.svc.p2p_supplicant=running
    start q5-wifi-retry

on property:init.svc.p2p_supplicant=stopped
    stop q5-wifi-retry

on property:init.svc.wpa_supplicant=running
    start q5-wifi-retry

on property:init.svc.wpa_supplicant=stopped
    stop q5-wifi-retry
